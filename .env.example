# BazarPOS Environment Variables Configuration
NEXT_PUBLIC_APP_NAME="BazarPOS Multi-Store POS"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Optional Cloud Database URL (Supabase / Vercel Postgres / MongoDB)
DATABASE_URL="postgres://user:password@hostname:5432/dbname"

# Optional SMS Gateway API Configuration (e.g. BulkSMSBD, Greenweb, Twilio)
SMS_API_KEY="your_sms_api_key_here"
SMS_SENDER_ID="BazarPOS"
